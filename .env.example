# Copy to .env (git-ignored) and fill in. Never commit real values.

# --- keys ---
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
# Key callers must send in the X-API-Key header (live mode). Any long random string.
API_KEY=
# Optional: more callers, each with its own key (16+ characters) and its own usage limits.
# Format: name:key,name2:key2   (names: letters, digits, - and _). Names show in logs; keys never do.
API_KEYS=

# --- database (live mode) ---
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://evidence:<POSTGRES_PASSWORD>@127.0.0.1:5433/evidence_rag

# live = Postgres + embeddings + Claude (the production mode, and the default)
EVIDENCE_RAG_MODE=live

# --- models ---
# Claude model and effort for answers (names start with ANSWER_ on purpose).
ANSWER_MODEL=claude-sonnet-5-5
ANSWER_EFFORT=low
# auto = Voyage API if VOYAGE_API_KEY is set, else a free local model (uv sync --extra local)
EMBEDDING_PROVIDER=auto
VOYAGE_EMBEDDING_MODEL=voyage-4
RERANK_MODEL=rerank-3

# --- server-side limits (the caller cannot change these) ---
RETRIEVAL_K=5
MAX_PDF_MB=10
MAX_PDF_PAGES=50

# --- usage limits on /ask and /retrieve (they cost money). Per caller. 0 = no limit. ---
# In memory, per process: with several workers or hosts, put the limit in a gateway or Redis.
ASK_PER_MINUTE=20
ASK_PER_DAY=500

# --- logs and browser access ---
# json = one object per line (log pipeline); text = for a terminal
LOG_FORMAT=json
LOG_LEVEL=INFO
# Browser origins allowed to call the API from another site, comma separated. Empty = none.
CORS_ORIGINS=
